# Supabase
# 프로젝트 대시보드 > Project Settings > API Keys 에서 확인
# https://supabase.com/dashboard/project/_/settings/api

# 브라우저(클라이언트)에 노출되는 값 — NEXT_PUBLIC_ 접두사 필요
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# 서버 전용 secret 키 — 절대 클라이언트에 노출 금지 (NEXT_PUBLIC_ 붙이지 말 것)
# RLS를 우회하는 관리 작업이 필요할 때만 사용
# SUPABASE_SECRET_KEY=sb_secret_xxx

# 데이터베이스 (Drizzle ORM용) — 대시보드 > Project Settings > Database > Connection string
# 런타임 쿼리: transaction 풀러(6543, IPv4 호환)
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres
# 마이그레이션(drizzle-kit): session 풀러(5432)
DIRECT_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
